# Required: Neon PostgreSQL connection string (keep private).
DATABASE_URL=
# Required: Clerk keys from the same Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Optional: full public URL. Vercel supplies a deployment URL automatically.
SITE_URL=

# Workspace admins; other members use server-managed Clerk public metadata.
FINANCE_ADMIN_EMAILS=
FINANCE_ORGANIZATION_ID=ledgerflow-org

# Optional: enables live, read-only AI answers. Keep the API key private.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
